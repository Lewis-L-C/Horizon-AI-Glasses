<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 相机预览 - 铺满全屏 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- OCR 覆盖层 - 铺满全屏 -->
    <com.blue.glassesapp.feature.home.ui.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ✅ UI 容器 - 铺满全屏，作为 UI 的父容器 -->
    <FrameLayout
        android:id="@+id/uiContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ✅ AI 状态 - 右上角顶格 -->
        <LinearLayout
            android:id="@+id/aiStatusLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:orientation="horizontal"
            android:background="@drawable/ai_status_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:elevation="8dp">

            <ImageView
                android:id="@+id/ivAiLogo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_ai_logo"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tvVoiceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎤 等待唤醒..."
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:maxWidth="120dp"
                android:ellipsize="end"
                android:maxLines="2" />

        </LinearLayout>

        <!-- ✅ 健康视图 - 左上角顶格（代码动态添加） -->
        <!-- healthStatusView 会在代码中添加到 uiContainer 的左上角 -->

        <!-- ✅ 底部回复 - 左下角顶格 -->
        <TextView
            android:id="@+id/tvBottomReply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:background="@drawable/bg_bottom_reply"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text=""
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:visibility="gone"
            android:maxWidth="160dp"
            android:minHeight="20dp"
            android:elevation="8dp" />

        <!-- ✅ 小地图 - 左上角顶格（AI状态下方） -->
        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="start|top"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_map_container"
            android:visibility="gone"
            android:elevation="8dp">

            <com.amap.api.maps.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="📍"
                android:textSize="12sp"
                android:elevation="4dp" />

            <TextView
                android:id="@+id/ivCloseMap"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="end|top"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="2dp"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:gravity="center"
                android:background="@drawable/bg_close_button"
                android:visibility="visible" />

        </FrameLayout>

    </FrameLayout>

</FrameLayout>